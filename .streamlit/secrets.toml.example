# Copy to .streamlit/secrets.toml for local use, or paste these into
# Streamlit Community Cloud under  App settings -> Secrets.
#
# NEVER commit the real secrets.toml - it is gitignored.

# Supabase Postgres.
#
# Get this from the project dashboard -> Connect (top bar) -> Direct ->
# Connection method: SESSION POOLER -> Type: URI.
#
# Do NOT use "Direct connection": it resolves over IPv6, and neither Streamlit
# Community Cloud nor GitHub Actions can reach IPv6 without the paid IPv4
# add-on. The session pooler is the IPv4 path and behaves like a normal
# connection.
#
# The password is NOT the one from project creation - that value is never
# viewable. Reset it under Database -> Settings -> Reset database password and
# copy it when shown.
DATABASE_URL = "postgresql://postgres.wtjkwaawpzzgjgtdwkrw:YOUR-DB-PASSWORD@<host-from-dashboard>:5432/postgres"

# Password gate for the public dashboard URL. Omit for an open local run.
APP_PASSWORD = "choose-something-only-you-know"

# Optional: phone notifications
# DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/..."

# Optional: Yahoo API, once access is approved
# YAHOO_CONSUMER_KEY = "..."
# YAHOO_CONSUMER_SECRET = "..."
